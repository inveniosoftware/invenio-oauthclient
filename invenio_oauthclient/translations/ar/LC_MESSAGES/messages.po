#: invenio_oauthclient/templates/semantic-ui/invenio_oauthclient/signup.html:25
#, python-format
msgid "Sign-up with %(title)s!"
msgstr "الاشتراك مع %(title)s!"

#: invenio_oauthclient/templates/invenio_oauthclient/signup.html:21
#: invenio_oauthclient/templates/semantic-ui/invenio_oauthclient/signup.html:28
msgid ""
"Fill in your details to complete your registration. You only have to do this"
" once."
msgstr "املأ بياناتك لإكمال تسجيلك. ما عليك سوى القيام بذلك مرة واحدة."

#: invenio_oauthclient/templates/invenio_oauthclient/signup.html:29
#: invenio_oauthclient/templates/semantic-ui/invenio_oauthclient/signup.html:41
msgid "Complete registration"
msgstr "أتمم التسجيل"

#: invenio_oauthclient/templates/invenio_oauthclient/settings/index.html:16
#: invenio_oauthclient/templates/semantic-ui/invenio_oauthclient/settings/index.html:18
#, python-format
msgid ""
"Tired of entering password for %(sitename)s every time you sign in? Set up "
"single sign-on with one or more of the services below:"
msgstr ""
"هل سئمت تكرار إدخال كلمة المرور عند تسجيل الدخول في %(sitename)s؟ قم بإعداد "
"تسجيل الدّخول مرّة واحدة في خدمة او خدمات أسفله:"

#: invenio_oauthclient/templates/invenio_oauthclient/settings/index.html:27
#: invenio_oauthclient/templates/semantic-ui/invenio_oauthclient/settings/index.html:51
msgid "Disconnect"
msgstr "قطع الاتصال"

#: invenio_oauthclient/templates/invenio_oauthclient/settings/index.html:29
#: invenio_oauthclient/templates/semantic-ui/invenio_oauthclient/settings/index.html:60
msgid "Connect"
msgstr "قم بالتوصيل"

#: invenio_oauthclient/templates/semantic-ui/invenio_oauthclient/login_user.html:35
msgid "Forgot password?"
msgstr "فقدت كلمة المرور؟"

#: invenio_oauthclient/templates/semantic-ui/invenio_oauthclient/login_user.html:41
msgid "Resend confirmation email"
msgstr "أعد إرسال تأكيد البريد الإلكتروني"
