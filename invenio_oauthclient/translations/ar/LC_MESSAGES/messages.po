#: invenio_oauthclient/contrib/keycloak/helpers.py:28
#, python-format
msgid ""
"Invalid app name %(app_name)s. It should only contain letters, numbers, "
"dashes and underscores"
msgstr ""
"اسم التطبيق غير صالح %(app_name)s. يجب أن يحتوي على أحرف وأرقام وشرطات "
"وشرطات سفلية فقط."

#: invenio_oauthclient/handlers/rest.py:86
#: invenio_oauthclient/handlers/token.py:67
#: invenio_oauthclient/handlers/ui.py:246
msgid "Authorization with remote service failed."
msgstr "فشل الإذن بالخدمة عن بعد."

#: invenio_oauthclient/handlers/rest.py:94
#: invenio_oauthclient/handlers/ui.py:61
msgid "You rejected the authentication request."
msgstr "لقد رفضت طلب المصادقة."

#: invenio_oauthclient/handlers/rest.py:98
#: invenio_oauthclient/handlers/ui.py:56
msgid "External service is already linked to another account."
msgstr "الخدمة الخارجية مرتبطة حاليا مع حساب أخر."

#: invenio_oauthclient/handlers/rest.py:108
msgid "Unauthorized."
msgstr "غير مرخّص"

#: invenio_oauthclient/handlers/rest.py:115
#: invenio_oauthclient/handlers/rest.py:285
msgid "Successfully signed up."
msgstr "تم التسجيل بنجاح."

#: invenio_oauthclient/handlers/rest.py:124
msgid "Token not found."
msgstr "الرمز Token غير موجود"

#: invenio_oauthclient/handlers/rest.py:131
msgid "Could not create token for user."
msgstr "لم يتمكن من إنشاء رمز token للمستخدم."

#: invenio_oauthclient/handlers/rest.py:211
msgid "Successfully authorized."
msgstr "تمت الموافقة على الإذن بنجاح."

#: invenio_oauthclient/handlers/rest.py:241
msgid "Successfully disconnected."
msgstr "تم قطع الاتصال بنجاح."

#: invenio_oauthclient/handlers/token.py:58
msgid "User rejected request."
msgstr "تم رفض الطلب من قبل المستخدم."

#: invenio_oauthclient/handlers/token.py:71
msgid "Bad OAuth authorized request"
msgstr "طلب تفويض OAuth غير صالح"

#: invenio_oauthclient/handlers/ui.py:88
#, python-format
msgid ""
"You can only link %(remote_name)s if you have already signed in through a "
"different method."
msgstr ""
"يمكنك الربط %(remote_name)s إذا كنت قد سجلت الدخول مسبقًا باستخدام طريقة "
"أخرى."

#: invenio_oauthclient/handlers/ui.py:161
#, python-format
msgid ""
"A confirmation email has already been sent to %(email)s. Didn't receive it? "
"Click <strong><a href=\"%(url)s\">here</a></strong> to resend it."
msgstr ""
"تم إرسال رسالة تأكيد إلى %(email)s. إن لم تستلمها؟ انقر <strong><a "
"href=\"%(url)s\">هنا</a></strong> لإعادة إرسالها."

#: invenio_oauthclient/handlers/utils.py:121
#, python-format
msgid ""
"Error while syncing roles: A managed role with id: %(group_id)s already "
"exists"
msgstr ""
"حدث خطأ أثناء مزامنة الأدوار: يوجد دور بصدد الإدارة يحمل المعرف id: "
"%(group_id)sبالفعل"

#: invenio_oauthclient/handlers/utils.py:131
#, python-format
msgid ""
"Error while syncing roles: A managed role with name: %(group_name)s already "
"exists"
msgstr ""
"حدث خطأ أثناء مزامنة الأدوار: يوجد دور بصدد الإدارة يحمل إسم: %(group_name)s"
" بالفعل"

